{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build --outDir dist/client",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/news",
      "schedule": "*/10 * * * *"
    }
  ]
}
