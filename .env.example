# Copy to .env; never commit credentials. Empty credentials disable only that provider.
# Backend only. Do not prefix private keys with VITE_ or PUBLIC_.

# Finnhub: US equities and financial news. Free personal tier; candles may need entitlement.
# https://finnhub.io/register
FINNHUB_API_KEY=

# One-year, read-only Analytics Token. NOT the daily OAuth token.
# https://account.upstox.com/developer/apps (Analytics tab)
# Enables NSE/BSE quotes, history, market status, and server-side WebSocket feed.
# Missing token -> /api/health reports UNCONFIGURED. No order APIs exist in this app.
UPSTOX_ANALYTICS_TOKEN=

# Gemini: on-demand sentiment analysis and chat research.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Genuine ProsusAI/finbert via Hugging Face Inference Providers.
# https://huggingface.co/settings/tokens (Inference Providers permission)
# Availability depends on account credits and provider model support.
HUGGINGFACE_API_KEY=

# Optional CoinGecko Demo key; otherwise use its public API.
COINGECKO_DEMO_API_KEY=

# Optional GoldAPI.io key. If empty, uses public gold-api.com.
# No silent fallback between providers after a failed request.
GOLD_API_KEY=
# Optional GoldAPI cache override in seconds, minimum 60. Default 86400 with a key,
# 60 without a key. Consider your account quota before lowering it.
# GOLD_CACHE_SECONDS=86400

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Required to enable AI in production; choose a long random application access token.
# This is distinct from provider secrets. Authorized users enter it in Settings;
# it is held only in memory. Use HTTPS and restrict access to trusted users.
AI_ACCESS_TOKEN=

# Vercel frontend: public HTTPS origin of an always-on Express backend.
BACKEND_ORIGIN=

# Optional Web Push: backend only. Use a private persistent disk, one server instance.
# Generate a VAPID pair with: npx web-push generate-vapid-keys
# Keep the private key secret; retain the pair across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Example on a mounted disk: /data/news-subscriptions.json
PUSH_STORE_PATH=

# Vercel-compatible background news delivery (OneSignal + external scheduler).
# App ID is public; the REST API key and cron secret must remain backend-only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PUBLIC_SITE_URL=
# At least 32 random characters. Scheduler sends Authorization: Bearer <secret>.
CRON_SECRET=

# Required when NODE_ENV=production. Generate a random value; never commit it.
# SESSION_SECRET=
ADMIN_DIAGNOSTICS_TOKEN=
# Keep public AI off until access policy and billing limits are reviewed.
ANONYMOUS_AI_QUOTA_ENABLED=false

# Account sync and price-alert history: backend only, private persistent disk.
# Vercel functions intentionally disable this feature; proxy to an always-on backend.
WORKSPACE_DB_PATH=

# Required persistent news queue (Upstash Redis REST, read/write token). Backend only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
