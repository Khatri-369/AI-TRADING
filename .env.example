# Global Markets Command Center - Environment Configuration
# Copy this file to .env and configure your keys.

# ==============================================================================
# AI Provider Keys
# ==============================================================================

# Gemini AI API Key (Required for contextual reasoning, Buy/Sell/Hold market signals, and scenario simulations)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Key (Required for genuine ProsusAI/finbert financial NLP transformer inference)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here
# Optional alias: HF_TOKEN
# HF_TOKEN=your_huggingface_token_here

# ==============================================================================
# Market Data Provider Keys
# ==============================================================================

# Finnhub API Key (Required for live US equities quotes, candles, and real-time market news)
# Free personal tier available at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Upstox Analytics Token (Required for Indian NSE/BSE equities, NIFTY 50, BANK NIFTY, SENSEX & WebSocket feed)
# Free read-only 1-year Analytics Token available at: https://developer.upstox.com/
# Leave empty if you do not track Indian markets; health endpoint will cleanly report UNCONFIGURED.
UPSTOX_ANALYTICS_TOKEN=your_upstox_analytics_token_here

# GoldAPI.io Access Key (Optional for spot Gold/Silver quotes; fallback to free public gold-api.com if omitted)
# Free tier (100 req/mo) available at: https://goldapi.io/
# GOLD_API_KEY=your_goldapi_key_here

# CoinGecko Demo API Key (Optional; public endpoint works without a key, demo key increases rate limit)
# Free demo key at: https://www.coingecko.com/en/api
# COINGECKO_DEMO_API_KEY=your_coingecko_demo_key_here

# ==============================================================================
# Server & Security Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Server Host (Default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Application Access Token (Required only in production mode to gate AI inference routes and prevent quota drainage)
# AI_ACCESS_TOKEN=your_strong_random_secret_token_here
