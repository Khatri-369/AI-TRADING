{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/",
  "name": "Tradexa — Global Markets Research",
  "short_name": "Tradexa",
  "description": "Track your watchlist, study charts and follow market news in one place.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#101216",
  "theme_color": "#101216",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    {
      "src": "/icons/tradexa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tradexa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/tradexa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Watchlist",
      "short_name": "Watchlist",
      "description": "Track saved instruments and price alerts",
      "url": "/watchlist",
      "icons": [{ "src": "/icons/tradexa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Market News",
      "short_name": "News",
      "description": "Market headlines and optional analysis",
      "url": "/news",
      "icons": [{ "src": "/icons/tradexa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "All Markets",
      "short_name": "Markets",
      "description": "Browse 42 multi-asset equities, commodities, and crypto",
      "url": "/markets",
      "icons": [{ "src": "/icons/tradexa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Research Tools",
      "short_name": "Tools",
      "description": "Interactive candlestick charts and trading journal",
      "url": "/tools",
      "icons": [{ "src": "/icons/tradexa-192.png", "sizes": "192x192" }]
    }
  ]
}
